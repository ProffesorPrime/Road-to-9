# Copy these into Vercel → Project → Settings → Environment Variables.
# Never share the secret ones or put them in the code.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key   # SECRET

# Anthropic console → API Keys (powers Professor Prime)
ANTHROPIC_API_KEY=sk-ant-...                                 # SECRET

# Your own login. The first time you sign in with this email you become the tutor.
TUTOR_EMAIL=you@example.com
TUTOR_NAME=Your first name

# Your website address, e.g. https://roadto9.com (no slash at the end)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional settings
PRIME_MODEL=claude-haiku-5-5        # the model Professor Prime uses
PRIME_DAILY_LIMIT=40                # Prime messages per student per day
APP_TIMEZONE=Asia/Dubai             # used for daily streaks
